}


#[test]

fn user_json_lists_account_fields() {
    let u = User {
        id: 7
        username: "daniel"
        email: "d@example.net"
        password: "salt$digest"
        role: "author"
        created_at: 5
    }
    assert_eq(user_json(u, false),
        "{\"id\":7,\"username\":\"daniel\",\"email\":\"d@example.net\",\"role\":\"author\",\"two_factor\":false}")
    assert_eq(user_json(u, true),
        "{\"id\":7,\"username\":\"daniel\",\"email\":\"d@example.net\",\"role\":\"author\",\"two_factor\":true}")
}


// ---------- two-factor login ----------

#[test]

fn totp_codes_are_six_digits_and_step_bound() {
    let secret = new_token("probe")
    // a code is always six decimal digits, whatever the step
    for s in #[0, 1, 7, 123456, -1] {
        let c = totp_code(secret, s)
        assert_eq(six_digits(c), true, "code for step " + s.to_string() + " must be six digits: " + c)
    }
    // consecutive steps give (almost surely) different codes
    assert_eq(totp_code(secret, 100) == totp_code(secret, 101), false)
    // the code is reproducible and matches across one step boundary
    let now = now_ms()
    let cur = totp_code(secret, totp_step(now))
    assert_eq(code_matches(secret, cur, now), true)
    assert_eq(code_matches(secret, cur, now + TOTP_STEP_MS), true, "a just-mailed code must survive one step boundary")
    assert_eq(code_matches(secret, cur, now + 5 * TOTP_STEP_MS), false, "an old code must stop matching")
    assert_eq(code_matches(secret, "000000", now), false)
    // the shape check rejects anything that is not six digits
    assert_eq(six_digits("12345"), false)
    assert_eq(six_digits("1234567"), false)
    assert_eq(six_digits("12a456"), false)
    assert_eq(six_digits(""), false)
}


#[test]

fn two_factor_challenges_expire_and_burn() {
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    let app = new_app()
    let mut eng = open_eng(app)
    // a fresh challenge answers, a wrong code keeps it alive but burns an
    // attempt, and the budget of wrong codes kills it
    put_2fa_challenge(&mut eng, "tok-2fa", 9, now_ms() + TWOFACTOR_VALIDITY_MS, 0)
    assert_eq(get_2fa_challenge(&mut eng, "tok-2fa").is_some(), true)
    bump_2fa_attempts(&mut eng, "tok-2fa")
    match get_2fa_challenge(&mut eng, "tok-2fa") {
        Some(ch) => {
            assert_eq(ch.uid, 9)
            assert_eq(ch.attempts, 1)
        }
        None => assert(false, "a wrong code must keep the challenge retryable")
    }
    bump_2fa_attempts(&mut eng, "tok-2fa")
    bump_2fa_attempts(&mut eng, "tok-2fa")
    match get_2fa_challenge(&mut eng, "tok-2fa") {
        Some(ch) => assert_eq(ch.attempts >= TWOFACTOR_MAX_ATTEMPTS, true, "the attempt budget must be reachable")
        None => assert(false, "the challenge survives until the endpoint judges the budget")
    }
    // an expired challenge is gone on sight
    put_2fa_challenge(&mut eng, "tok-old", 9, now_ms() - 1, 0)
    assert_eq(get_2fa_challenge(&mut eng, "tok-old").is_none(), true)
    // a malformed row and an unknown token are both just invalid
    let _ = eng.store.put("postwisp/2fa/chal/tok-junk", "garbage".as_bytes())
    assert_eq(get_2fa_challenge(&mut eng, "tok-junk").is_none(), true)
    assert_eq(get_2fa_challenge(&mut eng, "tok-nope").is_none(), true)
    // the opt-in flag and the secret round-trip
    assert_eq(two_factor_on(&mut eng, 9), false)
    set_two_factor(&mut eng, 9, true)
    assert_eq(two_factor_on(&mut eng, 9), true)
    set_two_factor(&mut eng, 9, false)
    assert_eq(two_factor_on(&mut eng, 9), false)
    let s1 = two_factor_secret(&mut eng, 9)
    assert_eq(s1.len() >= 32, true, "the secret is 32 hex chars from the CSPRNG")
    assert_eq(two_factor_secret(&mut eng, 9), s1, "the secret is minted once and then stable")
    let _ = fs::remove_dir_all(dir)
}


#[test]

fn login_with_two_factor_answers_a_challenge_then_a_session() {
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    env::set_var("PW_SMTP_HOST", "127.0.0.1")
    env::set_var("PW_SMTP_PORT", "1") // nothing listens: the send fails fast, the flow still runs
    let app = new_app()
    let mut eng = open_eng(app)
    let uid = insert_user_row(&mut eng, "bob", "bob@example.net", hash_password("hunter2hunter2!"), "author")
    set_two_factor(&mut eng, uid, true)

    // before opt-in, the password alone logs in
    let r_plain = handle_login(app, treq("/api/login", "{\"username\":\"bob\",\"password\":\"hunter2hunter2!\"}"))
    assert_eq(r_plain.status, 200, "a plain account logs straight in")

    // after opt-in, the same credentials answer a challenge, no session
    set_two_factor(&mut eng, uid, true)
    let r_chal = handle_login(app, treq("/api/login", "{\"username\":\"bob\",\"password\":\"hunter2hunter2!\"}"))
    assert_eq(r_chal.status, 200)
    assert_eq(strings::contains(r_chal.body, "\"two_factor\":true"), true, "the login must hand back a challenge: " + r_chal.body)
    assert_eq(strings::contains(r_chal.body, "\"token\""), true)
    let tok = field(parse_body(r_chal.body), "token")

    // a wrong password never reaches the code step
    let r_bad = handle_login(app, treq("/api/login", "{\"username\":\"bob\",\"password\":\"wrongwrong1!\"}"))
    assert_eq(r_bad.status, 401)

    // the code the server would have mailed closes the login
    let code = totp_code(two_factor_secret(&mut eng, uid), totp_step(now_ms()))
    let r_code = handle_login_2fa(app, treq("/api/login/2fa", "{\"token\":" + json_quote(tok) + ",\"code\":\"" + code + "\"}"))
    assert_eq(r_code.status, 200, "the mailed code must open the session: " + r_code.body)
    let mut cookie = ""
    for (n, v) in r_code.headers {
        if n.to_lowercase() == "set-cookie" { cookie = v }
    }
    assert_eq(cookie.starts_with("postwisp_session="), true, "the code must log the user in")

    // the challenge is single-use: a replayed code is just invalid
    let r_replay = handle_login_2fa(app, treq("/api/login/2fa", "{\"token\":" + json_quote(tok) + ",\"code\":\"" + code + "\"}"))
    assert_eq(r_replay.status, 400)

    // a wrong code is refused and retryable, an out-of-shape one never asked
    set_two_factor(&mut eng, uid, true)
    let r_chal2 = handle_login(app, treq("/api/login", "{\"username\":\"bob\",\"password\":\"hunter2hunter2!\"}"))
    assert_eq(r_chal2.status, 200)
    let tok2 = field(parse_body(r_chal2.body), "token")
    let r_wrong = handle_login_2fa(app, treq("/api/login/2fa", "{\"token\":" + json_quote(tok2) + ",\"code\":\"000000\"}"))
    assert_eq(r_wrong.status, 400)
    let r_shape = handle_login_2fa(app, treq("/api/login/2fa", "{\"token\":" + json_quote(tok2) + ",\"code\":\"abc\"}"))
    assert_eq(r_shape.status, 400)
    // the challenge survives the wrong tries and still closes
    let code2 = totp_code(two_factor_secret(&mut eng, uid), totp_step(now_ms()))
    let r_close = handle_login_2fa(app, treq("/api/login/2fa", "{\"token\":" + json_quote(tok2) + ",\"code\":\"" + code2 + "\"}"))
    assert_eq(r_close.status, 200, "a wrong code must not kill the challenge: " + r_close.body)

    // opt-out restores single-step login
    set_two_factor(&mut eng, uid, false)
    let r_off = handle_login(app, treq("/api/login", "{\"username\":\"bob\",\"password\":\"hunter2hunter2!\"}"))
    assert_eq(r_off.status, 200)
    assert_eq(strings::contains(r_off.body, "\"token\""), false, "no challenge once opted out: " + r_off.body)

    // leave the environment clean for the tests that follow
    env::set_var("PW_SMTP_HOST", "")
    env::set_var("PW_SMTP_PORT", "")
    let _ = fs::remove_dir_all(dir)
}


#[test]

fn hex8_renders_eight_digits() {
    assert_eq(hex8(0), "00000000")
    assert_eq(hex8(255), "000000ff")
    assert_eq(hex8(3_735_928_559), "deadbeef")
}

// ---------- regression tests for the adversarial pass ----------
//
// Each test below pins a bug found in review: byte-walking loops that
// indexed the string by CHAR (panicking past the char count on any
// non-ASCII input), the bare-## heading panic, the #foo infinite loop,
// and zip entry sizes recorded as char counts.

#[test]

fn markdown_survives_non_ascii_text() {
    // accented letters, currency, emoji: render, don't panic, don't drop
    let h = render_markdown("# Café ünïcödé\n\nEin Kaffee kostet 3€ — ça va 😊\n")
    assert_eq(h.contains("<h1>Café ünïcödé</h1>"), true)
    assert_eq(h.contains("3€"), true)
    assert_eq(h.contains("ça va 😊"), true)
    // a table with non-ascii cells (split_row walked bytes, read chars)
    let t = render_markdown("| Wort | Preis |\n|---|---|\n| Kaffee | 3€ |\n| Crème | 4€ |\n")
    assert_eq(t.contains("<td>Kaffee</td>"), true)
    assert_eq(t.contains("<td>3€</td>"), true)
    assert_eq(t.contains("<td>Crème</td>"), true)
    // inline markup around multi-byte sequences
    let i = render_markdown("*wichtig*: naïve **ça**\n")
    assert_eq(i.contains("<em>wichtig</em>"), true)
    assert_eq(i.contains("<strong>ça</strong>"), true)
    // a JSON-escaped body with non-ascii survives the round trip
    let f = parse_body("{\"source\":\"naïve café ☕ text\"}")
    assert_eq(field(f, "source"), "naïve café ☕ text")
}

#[test]

fn markdown_bare_hashes_are_paragraphs_not_panics() {
    // a line of only hashes has no char at trimmed[level]: it used to
    // panic the handler; it is a paragraph
    let h = render_markdown("##\n")
    assert_eq(h.contains("<p>##</p>"), true)
    let h2 = render_markdown("#\n")
    assert_eq(h2.contains("<p>#</p>"), true)
    // seven hashes exceeds the deepest heading level: paragraph too
    let h3 = render_markdown("####### spaced but too deep\n")
    assert_eq(h3.contains("<h7>"), false)
    assert_eq(h3.contains("<p>"), true)
}

#[test]

fn markdown_hash_without_space_terminates() {
    // "#foo" is not a heading (no space) and used to wedge the paragraph
    // walker in an infinite loop: this test completing at all is the fix
    let h = render_markdown("#foo\n\nsecond paragraph\n")
    assert_eq(h.contains("<p>#foo</p>"), true)
    assert_eq(h.contains("<p>second paragraph</p>"), true)
    // the same shape mid-document, after a real heading
    let h2 = render_markdown("# Title\n\n#bar\n\ntail\n")
    assert_eq(h2.contains("<h1>Title</h1>"), true)
    assert_eq(h2.contains("<p>#bar</p>"), true)
    assert_eq(h2.contains("<p>tail</p>"), true)
}

#[test]

fn excerpt_and_cover_handle_non_ascii() {
    // excerpt_of walked bytes but read s[i] (chars): panic on é
    let e = excerpt_of("Ein Café in Zürich ☕")
    assert_eq(e, "Ein Café in Zürich ☕")
    // the 200-CHAR cut never slices a multi-byte sequence in half
    let mut s = String::new()
    let mut k: i64 = 0
    while k < 250 { s += "é"; k += 1 } // 250 chars, 500 bytes: past the cut
    let t = excerpt_of(s)
    assert_eq(t.len() > 0, true)
    assert_eq(sub(t, t.byte_len() - 3, t.byte_len()), "...")
    // the last complete char before the ellipsis is é, not a broken byte
    let before = sub(t, 0, t.byte_len() - 3)
    assert_eq(before.byte_len() % 2, 0, "cut must land on a char boundary")
    assert_eq(before.contains("\u{FFFD}"), false)
    // a cover with non-ascii alt text
    assert_eq(cover_url_of("![Café](/a.png)"), "/a.png")
}

#[test]

fn cookie_splitting_tolerates_non_ascii_values() {
    // split_byte walked bytes but pushed s[i] (chars): a hostile or
    // international Cookie header panicked cookie_of/current_user
    let parts = split_byte("a=1; postwisp_session=tökën; b=2", ';' as u8)
    assert_eq(parts.len(), 3)
    assert_eq(parts[1].trim(), "postwisp_session=tökën")
    let parts2 = split_byte("naïve; café", ';' as u8)
    assert_eq(parts2.len(), 2)
    assert_eq(parts2[0], "naïve")
}

#[test]

fn zip_sizes_are_byte_counts_even_for_non_ascii() {
    let stamp = post_stamp(codec::datetime::parse("2025-01-15T10:30:45Z").unwrap_or(0))
    // "Café" is 5 bytes / 4 chars; the old writer recorded the char
    // count, understating sizes and corrupting the archive
    let body = "# Café ☕\n" // 11 bytes, 9 chars
    let mut entries: Vec<ZipEntry> = #[]
    entries.push(ZipEntry {
        name: zip_name_for("Café", stamp)
        body: body
        crc: crc32::checksum_string(body) as i64
        dos_time: stamp.dos_time
        dos_date: stamp.dos_date
        offset: 0
    })
    let z = zip_bytes(entries)
    // local header: comp size at offset 18, uncomp at 22 — both BYTES
    assert_eq(z[18] == body.byte_len() as u8, true, "compressed size must be the byte count")
    assert_eq(z[22] == body.byte_len() as u8, true, "uncompressed size must be the byte count")
    // name length is the byte count: "Café-2025-01-15-103045.md" = 27 bytes
    let nl = z[26] as i64 + (z[27] as i64) * 256
    assert_eq(nl, zip_name_for("Café", stamp).byte_len())
    // the central directory agrees
    let cd = 30 + nl + body.byte_len()
    assert_eq(z[cd + 20] == body.byte_len() as u8, true)
    // and the archive really is readable: the body's BYTES follow the name
    let body_at = 30 + nl
    let bb = body.bytes()
    let mut k: i64 = 0
    while k < bb.len() {
        assert_eq(z[body_at + k], bb[k], "zip body byte " + k.to_string() + " must match the source")
        k += 1
    }
}

#[test]

fn setup_login_persists_a_working_session() {
    // Regression: handle_setup used to write the one-time setup token
    // into the session cookie instead of the session it had just created,
    // so the fresh admin's /api/me answered 401 and the dashboard greeted
    // them with "not logged in" as an error on the screen that had just
    // created their account.
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    let app = new_app()
    let mut eng = open_eng(app)
    let store = read_store(&mut eng)
    let token = store.setup_token
    assert_eq(token.len() > 0, true, "first boot must mint a setup token")

    let body = "{\"token\":\"" + token + "\",\"username\":\"admin\","
        + "\"email\":\"a@b.c\",\"password\":\"sup3rsecret1!\"}"
    let req = http::Request {
        method: "POST"
        path: "/api/setup"
        query: ""
        query_pairs: #[]
        headers: #[]
        body: body
        raw_body: #[]
        peer_addr: "127.0.0.1:1"
    }
    let resp = handle_setup(app, req)
    assert_eq(resp.status, 200, "setup must succeed")

    // pull the session cookie out of the response
    let mut cookie = ""
    for (n, v) in resp.headers {
        if n.to_lowercase() == "set-cookie" { cookie = v }
    }
    assert_eq(cookie.starts_with("postwisp_session="), true,
        "setup must set a session cookie, got: " + cookie)
    let rest = sub(cookie, "postwisp_session=".len(), cookie.len())
    let cut = find_sub(rest, ";", 0)
    let sess = if cut >= 0 { sub(rest, 0, cut) } else { rest }
    assert_eq(sess == token, false,
        "the cookie carried the one-time setup token, not a session")

    // the cookie must be a real session: /api/me with it answers 200,
    // never the 401 that used to read as "you are not logged in"
    let me_req = http::Request {
        method: "GET"
        path: "/api/me"
        query: ""
        query_pairs: #[]
        headers: #[("Cookie", "postwisp_session=" + sess)]
        body: ""
        raw_body: #[]
        peer_addr: "127.0.0.1:1"
    }
    let me = handle_me(app, me_req)
    assert_eq(me.status, 200,
        "the session cookie set by setup must authenticate /api/me, got "
        + me.status.to_string())
}

// ---------- account recovery tests ----------
//
// The SMTP side is exercised against a port nothing listens on: the send
// fails fast, which is exactly the path a misconfigured relay takes.

fn treq(path: String, body: String) -> http::Request {
    http::Request {
        method: "POST"
        path: path
        query: ""
        query_pairs: #[]
        headers: #[]
        body: body
        raw_body: #[]
        peer_addr: "127.0.0.1:1"
    }
}

#[test]

fn reset_tokens_are_single_use_and_expire() {
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    let app = new_app()
    let mut eng = open_eng(app)
    // a fresh token answers once, then never again
    put_reset_token(&mut eng, "tok-alice", 7, now_ms() + RESET_TTL_MS)
    assert_eq(take_reset_token(&mut eng, "tok-alice"), Some(7))
    assert_eq(take_reset_token(&mut eng, "tok-alice"), None)
    // an expired token is consumed but answers nothing
    put_reset_token(&mut eng, "tok-old", 8, now_ms() - 1)
    assert_eq(take_reset_token(&mut eng, "tok-old"), None)
    // an unknown token and a malformed row are both just invalid
    assert_eq(take_reset_token(&mut eng, "tok-nope"), None)
    let _ = eng.store.put("postwisp/reset/tok-bad", "junk".as_bytes())
    assert_eq(take_reset_token(&mut eng, "tok-bad"), None)
}

#[test]

fn recover_answers_are_generic_and_capped() {
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    env::set_var("PW_SMTP_HOST", "")
    let app = new_app()
    let mut eng = open_eng(app)
    let hash = hash_password("first password1!")
    let uid = insert_user_row(&mut eng, "alice", "alice@example.net", hash, "author")
    assert_eq(uid > 0, true, "the user row must exist")

    // unconfigured server: a named 503, never a fake "check your mail"
    let r_off = handle_recover(app, treq("/api/recover", "{\"email\":\"alice@example.net\"}"))
    assert_eq(r_off.status, 503)

    // configured relay (a port nothing listens on): a known address and an
    // unknown one answer EXACTLY alike — same status, same body
    env::set_var("PW_SMTP_HOST", "127.0.0.1")
    env::set_var("PW_SMTP_PORT", "1")
    let r_known = handle_recover(app, treq("/api/recover", "{\"email\":\"alice@example.net\"}"))
    let r_unknown = handle_recover(app, treq("/api/recover", "{\"email\":\"nobody@example.net\"}"))
    assert_eq(r_known.status, 200)
    assert_eq(r_unknown.status, 200, "an unknown address must answer the same status")
    assert_eq(r_known.body, r_unknown.body, "an unknown address must answer the same body")

    // the send was counted: one row is under the cap, the limit trips at
    // RECOVER_MAX_SENDS, and past it the endpoint answers 429
    let mut eng2 = open_eng(app)
    assert_eq(recover_sends_capped(&mut eng2, "127.0.0.1"), false, "one send is under the cap")
    let mut k: i64 = 1
    while k < RECOVER_MAX_SENDS {
        let _ = handle_recover(app, treq("/api/recover", "{\"email\":\"alice@example.net\"}"))
        k += 1
    }
    let mut eng3 = open_eng(app)
    assert_eq(recover_sends_capped(&mut eng3, "127.0.0.1"), true, "the cap must trip at the limit")
    let r_capped = handle_recover(app, treq("/api/recover", "{\"email\":\"alice@example.net\"}"))
    assert_eq(r_capped.status, 429)

    // leave the process environment clean for the tests that follow
    env::set_var("PW_SMTP_HOST", "")
    env::set_var("PW_SMTP_PORT", "")
}

#[test]

fn reset_sets_password_logs_in_and_kills_old_sessions() {
    let dir = env::temp_dir() + "/pw-test-" + new_token("d")
    let _ = fs::create_dir_all(dir)
    env::set_var("PW_DATA", dir)
    let app = new_app()
    let mut eng = open_eng(app)
    let hash = hash_password("first password1!")
    let uid = insert_user_row(&mut eng, "alice", "alice@example.net", hash, "author")
    assert_eq(uid > 0, true, "the user row must exist")
    // a session that must not survive the reset
    exec_sql(&mut eng, "INSERT INTO sessions VALUES ('oldsess', " + uid.to_string() + ", 1, 2)")
    put_reset_token(&mut eng, "tok-reset", uid, now_ms() + RESET_TTL_MS)

    // a weak password is refused WITHOUT burning the link
    let r_weak = handle_reset(app, treq("/api/reset", "{\"token\":\"tok-reset\",\"password\":\"short1!\"}"))
    assert_eq(r_weak.status, 400)

    // the real reset: 200, a fresh session cookie, and the caller logged in
    let r = handle_reset(app, treq("/api/reset", "{\"token\":\"tok-reset\",\"password\":\"second password2!\"}"))
    assert_eq(r.status, 200)
    let mut cookie = ""
    for (n, v) in r.headers {
        if n.to_lowercase() == "set-cookie" { cookie = v }
    }
    assert_eq(cookie.starts_with("postwisp_session="), true, "reset must log the user in")

    // the new password verifies, the old one does not
    let mut eng2 = open_eng(app)
    let store = read_store(&mut eng2)
    match find_user_by_name(store, "alice") {
        Some(u) => {
            assert_eq(verify_password(u.password, "second password2!"), true)
            assert_eq(verify_password(u.password, "first password1!"), false)
        }
        None => assert(false, "alice must still exist after the reset")
    }
    // the pre-reset session is gone; exactly the fresh one remains
    let mut old_alive = false
    let mut live: i64 = 0
    for s in store.sessions {
        if s.token == "oldsess" { old_alive = true }
        if s.user_id == uid { live += 1 }
    }
    assert_eq(old_alive, false, "the pre-reset session must be gone")
    assert_eq(live, 1, "exactly the fresh session remains")
    // a replayed token is just another invalid one
    let r_replay = handle_reset(app, treq("/api/reset", "{\"token\":\"tok-reset\",\"password\":\"third password3!\"}"))
    assert_eq(r_replay.status, 400)
}


// ---------- tests: feed, ordering, favicon, asset caching ----------


fn tpost(id: i64, user_id: i64, title: String, slug: String, status: String, published_at: i64) -> Post {
    Post {
        id: id
        user_id: user_id
        title: title
        source: "# " + title
        content: "<h1>" + title + "</h1>"
        tags: ""
        status: status
        published_at: published_at
        slug: slug
        created_at: published_at
        modified_at: published_at
    }
}


fn tget(path: String, headers: Vec<(String, String)>) -> http::Request {
    http::Request {
        method: "GET"
        path: path
        query: ""
        query_pairs: #[]
        headers: headers
        body: ""
        raw_body: #[]
        peer_addr: "127.0.0.1:1"
    }
}


fn resp_header(r: http::Response, name: String) -> String {
    for (n, v) in r.headers {
        if n.to_lowercase() == name.to_lowercase() { return v }
    }
    ""
}


#[test]

fn feed_is_valid_atom_with_absolute_urls() {
    let posts = #[tpost(1, 7, "First", "first", "published", 1_700_000_000_000)
        , tpost(2, 7, "Second", "second", "published", 1_700_000_060_000)]
    let xml = feed_xml("https://example.com", "alice", "Alice's notes", posts)
    // the feed-level author RFC 4287 requires
    assert_eq(xml.contains("<author><name>alice</name></author>"), true, "feed must carry an author element")
    // every href and id is absolute
    assert_eq(xml.contains("href=\"https://example.com/alice/feed.xml\""), true, "self link must be absolute")
    assert_eq(xml.contains("href=\"https://example.com/alice\""), true, "alternate link must be absolute")
    assert_eq(xml.contains("<id>https://example.com/alice/second</id>"), true, "entry ids must be absolute")
    assert_eq(xml.contains("href=\"https://example.com/alice/second\""), true, "entry links must be absolute")
    assert_eq(xml.contains("rel=\"alternate\""), true, "links must name their relation")
    // no relative href or id survives anywhere in the document
    assert_eq(xml.contains("href=\"/"), false, "no relative href may remain")
    assert_eq(xml.contains("<id>/"), false, "no relative id may remain")
    // titles are escaped
    let x2 = feed_xml("https://example.com", "bob", "Bob & <b>friends</b>", #[])
    assert_eq(x2.contains("Bob &amp; &lt;b&gt;friends&lt;/b&gt;"), true, "the feed title must be escaped")
}


#[test]

fn post_ordering_is_deterministic_on_the_same_instant() {
    let a = tpost(1, 7, "A", "a", "published", 1_700_000_000_000)
    let b = tpost(2, 7, "B", "b", "published", 1_700_000_000_000)
    // same millisecond: the newer post (higher id) sorts first, both ways
    assert_eq(pub_cmp(b, a), -1, "higher id wins on a tie")
    assert_eq(pub_cmp(a, b), 1, "the tie-break is stable in both directions")
    assert_eq(post_cmp(b, a), -1, "the dashboard sort shares the tie-break")
    let mut xs = #[a, b]
    xs.sort_by(|p, q| pub_cmp(p, q))
    assert_eq(xs[0].id, 2, "the sorted feed begins with the newer post")
    assert_eq(xs[1].id, 1)
}


#[test]

fn favicon_is_a_wellformed_ico_with_transparency() {
    let ico = favicon_ico()
    let n = ico.len()
    // ICONDIR: reserved 0, type 1 (icon), one image
    assert_eq(n > 22, true, "the file must carry pixels past its headers")
    assert_eq(ico[0], 0)
    assert_eq(ico[2], 1)
    assert_eq(ico[4], 1)
    assert_eq(ico[6], 16)
    assert_eq(ico[7], 16)
    // the declared image length accounts for exactly the remaining bytes
    let declared = (ico[14] as i64) | ((ico[15] as i64) << 8) | ((ico[16] as i64) << 16) | ((ico[17] as i64) << 24)
    assert_eq(22 + declared, n, "the directory's size field must match the file")
    // the pixel payload carries both the accent (B A7 C3 4F FF) and
    // transparent (all zero) pixels — a crescent, not a full square
    let mut accent = 0
    let mut clear = 0
    let mut i = 22 + 40
    while i < n - 64 {
        if ico[i] == 0 && ico[i + 1] == 0 && ico[i + 2] == 0 && ico[i + 3] == 0 { clear += 1 }
        else { accent += 1 }
        i += 4
    }
    assert_eq(accent > 0, true, "some pixels must be the accent colour")
    assert_eq(clear > 0, true, "some pixels must be transparent")
}


#[test]

fn built_in_assets_revalidate_to_304() {
    // the suite runs from the project root, so web/ is the default web dir
    let app = new_app()
    let first = web_asset_response(app, tget("/app.css", #[]), "app.css", "text/css; charset=utf-8")
    assert_eq(first.status, 200, "a first fetch must answer the file")
    let etag = resp_header(first, "ETag")
    assert_eq(etag.len() > 2, true, "the asset must carry a strong ETag")
    let cc = resp_header(first, "Cache-Control")
    assert_eq(cc.contains("max-age=300"), true, "the freshness window must be set")
    // a revalidation naming that ETag transfers nothing
    let again = web_asset_response(app, tget("/app.css", #[("If-None-Match", etag)]), "app.css", "text/css; charset=utf-8")
    assert_eq(again.status, 304, "a matching If-None-Match must answer 304")
    // a stale or absent ETag still serves the bytes
    let stale = web_asset_response(app, tget("/app.css", #[("If-None-Match", "\"zzz\"")]), "app.css", "text/css; charset=utf-8")
    assert_eq(stale.status, 200, "a non-matching ETag must answer the file")
    // the wildcard form matches anything present
    let wild = web_asset_response(app, tget("/app.css", #[("If-None-Match", "*")]), "app.css", "text/css; charset=utf-8")
    assert_eq(wild.status, 304, "If-None-Match: * is a match")
    // a missing file is a 404, never a crash
    let gone = web_asset_response(app, tget("/nope.css", #[]), "nope.css", "text/css; charset=utf-8")
    assert_eq(gone.status, 404, "a missing asset must answer 404")
}

