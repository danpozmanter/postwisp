#[test]

fn password_policy() {
    assert_eq(valid_password("correct horse1!"), true)
    assert_eq(valid_password("short1!"), false)
    assert_eq(valid_password("nodigits!!!"), false)
    assert_eq(valid_password("no punctuation 12"), false)
}


#[test]

fn login_rate_limit_counts_and_expires() {
    let mut l = LoginAttempts { fails: #[] }
    let now = 1_000_000
    // four stale entries from far in the past must not count
    for i in 0..4 {
        l.fails.push(LoginAttempt { ip: "1.1.1.1", username: "alice", at: now - 20 * 60 * 1000 - i })
    }
    assert_eq(count_recent_fails(l, "1.1.1.1", "alice", now), 0)
    // four fresh failures: allowed, then the fifth locks the pair
    for _ in 0..4 {
        l.fails.push(LoginAttempt { ip: "1.1.1.1", username: "alice", at: now - 1000 })
    }
    assert_eq(count_recent_fails(l, "1.1.1.1", "alice", now), 4)
    assert_eq(count_recent_fails(l, "1.1.1.1", "alice", now) >= LOGIN_MAX_FAILS, false)
    l.fails.push(LoginAttempt { ip: "1.1.1.1", username: "alice", at: now })
    assert_eq(count_recent_fails(l, "1.1.1.1", "alice", now), 5)
    assert_eq(count_recent_fails(l, "1.1.1.1", "alice", now) >= LOGIN_MAX_FAILS, true)
    // the lock is per (ip, username) pair: the owner from another host
    // and other names from the attacker's host are unaffected
    assert_eq(count_recent_fails(l, "2.2.2.2", "alice", now), 0)
    assert_eq(count_recent_fails(l, "1.1.1.1", "bob", now), 0)
    assert_eq(count_recent_fails(l, "2.2.2.2", "bob", now), 0)
}


