fn body_parsing_reads_each_field() {
    let f = parse_body("{\"title\":\"my post\",\"source\":\"has \\\"quotes\\\" and \\\\ backslash\",\"tags\":\"a,b\"}")
    assert_eq(field(f, "title"), "my post")
    assert_eq(field(f, "source"), "has \"quotes\" and \\ backslash")
    assert_eq(field(f, "tags"), "a,b")
    assert_eq(field(f, "missing"), "")
    let g = parse_body("not json at all")
    assert_eq(field(g, "title"), "")
}


