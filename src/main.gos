fn markdown_links_noopener_and_js_blocked() {
    let html = render_markdown("[x](https://e.com) [y](javascript:alert(1))\n")
    assert_eq(html.contains("rel=\"noopener\""), true)
    assert_eq(html.contains("href=\"#\""), true)
}


#[test]

fn markdown_list_quote_table_strike() {
    let html = render_markdown("- a\n- b\n\n> quoted\n\n| h1 | h2 |\n|---|---|\n| 1 | 2 |\n\n~~gone~~\n")
    assert_eq(html.contains("<ul>"), true)
    assert_eq(html.contains("<li>a</li>"), true)
    assert_eq(html.contains("<blockquote>"), true)
    assert_eq(html.contains("<table>"), true)
    assert_eq(html.contains("<td>1</td>"), true)
    assert_eq(html.contains("<del>gone</del>"), true)
}


#[test]

fn slug_validation() {
