fn sql_literals_are_escaped() {
    assert_eq(sqlq("it's"), "'it''s'")
    assert_eq(sqlq("a\\b"), "'a\\\\b'")
    assert_eq(sqlq("plain"), "'plain'")
}


#[test]

fn hex8_renders_eight_digits() {
    assert_eq(hex8(0), "00000000")
    assert_eq(hex8(255), "000000ff")
    assert_eq(hex8(3735928559), "deadbeef")
}
